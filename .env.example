# =====================================
# LLM Custom Service - 环境变量配置
# =====================================
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# 注意: .env 文件已加入 .gitignore，不会上传到 GitHub

# --- Pinecone 配置 ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-west-2
PINECONE_INDEX_NAME=ecommerce-kb

# --- HuggingFace Token ---
HF_TOKEN=your_huggingface_token_here

# --- 数据库配置 ---
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/llm_chatbot?charset=utf8mb4
# 以下变量供独立脚本（migrate_chat_sessions.py 等）使用
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=llm_chatbot

# --- LLM 配置 ---
LLM_PROVIDER=deepseek
VOLC_ACCESSKEY=your_volc_accesskey_here
VOLC_SECRETKEY=your_volc_secretkey_here
VOLC_MODEL_ID=ep-xxxxxxxxxxxxxxxx

# --- JWT 密钥 (生产环境请更换为随机字符串) ---
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- 其他路径配置 ---
EXCEL_PATH=D:/browserdownloads/LLM-DATASET.xlsx
